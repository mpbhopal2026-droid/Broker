# ==========================================
# GLOBAL FOREX — ENVIRONMENT
# ==========================================
# Two groups, and the split is not cosmetic.
#
#   FRONTEND (NEXT_PUBLIC_*) is inlined into the JavaScript bundle at build
#   time and readable by every visitor. Putting a secret here does not leak it
#   eventually — it publishes it immediately.
#
#   BACKEND is server-only. Never add a NEXT_PUBLIC_ prefix to any of it.
#
# GET /api/health (signed in as an operator) reports which are missing and
# warns if a secret has been given a public prefix.

# ---------- FRONTEND KEYS (public, in the browser bundle) ----------
# 1. Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Resend
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Global Forex <noreply@globalforex.online>"

# 3. Web Push / VAPID  (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# 4. Firebase Web Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-fcm-web-push-cert-key

# ---------- BACKEND KEYS (server only, never NEXT_PUBLIC_) ----------
# 5. Session signing secret — REQUIRED (generate: openssl rand -base64 32)
# Both deployments must share this value, or a session issued by one will not
# verify in the other. Rotating it signs everybody out.
SESSION_SECRET=generate-a-random-32-byte-secret

# 6. KYC field encryption — REQUIRED before storing real identity documents.
# Must decode to exactly 32 bytes: openssl rand -base64 32
# Losing this key makes stored document numbers unrecoverable. Back it up
# somewhere separate from the database.
KYC_ENCRYPTION_KEY=generate-a-random-32-byte-key

# 7. Public URL, used for links in outgoing email
NEXT_PUBLIC_APP_URL=https://app.globalforex.online

# ==========================================
# 7b. DEPLOYMENT SPLIT — two Vercel projects
# ==========================================
# apps/client -> app.globalforex.online    APP_ROLE=client
# apps/admin  -> admin.globalforex.online  APP_ROLE=admin
# Each project sets Root Directory to its own app folder. Session cookies are
# host-only, so a client session is never sent to the admin console.
APP_ROLE=client
NEXT_PUBLIC_ADMIN_URL=https://admin.globalforex.online

# Optional extra lock on the admin console. Only meaningful behind a proxy that
# overwrites x-forwarded-for (Vercel, Cloudflare, nginx real_ip).
# ADMIN_IP_ALLOWLIST=203.0.113.7,198.51.100.0/24

# 8. Support & DPDP grievance contacts — published to clients, must be real
SUPPORT_EMAIL=support@mail.globalforex.online
GRIEVANCE_OFFICER_EMAIL=grievance@mail.globalforex.online
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=Full name of the appointed officer
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=grievance@mail.globalforex.online
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=+91 XXXXX XXXXX
NEXT_PUBLIC_COMPANY_ADDRESS=Registered office address

# 9. SMS provider for phone login (optional — email OTP works without it)
# MSG91 is the usual choice for Indian numbers and handles TRAI DLT templates.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=GLBFRX
# Twilio fallback for international numbers:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Live market data (server only)
# ---------------------------------------------------------------------------
# Without these the app serves simulated quotes that are explicitly labelled as
# simulated. It never presents made-up prices as live.
#
# Get a key: https://twelvedata.com/pricing -> Sign up -> Dashboard -> API Keys.
# The free tier gives 800 requests/day and 8/minute, which is enough for a
# 5-second refresh only if you cache; paid Grow tier lifts the per-minute cap.
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Resend delivery webhook (server only)
# ---------------------------------------------------------------------------
# Resend dashboard -> Webhooks -> Add Endpoint
#   URL: https://globalforex.vercel.app/api/webhooks/resend
# Copy the "Signing Secret" (starts with whsec_) here.
# Without it the webhook rejects every event and delivery stays unknown.
RESEND_WEBHOOK_SECRET=

# Seconds between live quote refreshes. Twelve Data bills 1 credit per symbol,
# so cost/minute = (60 / this) * number_of_instruments. With 6 instruments:
#   5s -> 72 credits/min (needs Pro)
#   7s -> 52 credits/min (fits Grow's 55)
# Free tier is 8/min and excludes commodities, so it cannot serve XAU or WTI.
MARKET_DATA_REFRESH_SECONDS=7

# ---------------------------------------------------------------------------
# Cloudinary (server only) — document storage
# ---------------------------------------------------------------------------
# No fallbacks in code: missing config fails closed by design. A default that
# is a live credential removes the error that would have told you config was
# missing, and eventually gets published.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
